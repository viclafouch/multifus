{
  "name": "@multifus/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "build": "tsc && vite build",
    "build:app": "node scripts/reset-authorization.mjs && tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "draw:icon": "node scripts/draw-icon.mjs",
    "draw:dmg": "node scripts/draw-dmg.mjs",
    "preview:dmg": "node scripts/preview-dmg.mjs",
    "draw:nsis": "node scripts/draw-nsis.mjs",
    "typecheck": "tsc --noEmit",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui check sync --clean && lingui compile --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "deny:rust": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "check:web": "pnpm run i18n:check && pnpm run test && pnpm run build",
    "check:rust": "pnpm run format:rust:check && pnpm run lint:rust && pnpm run test:rust",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@lingui/core": "^6.8.0",
    "@multifus/ankama": "workspace:*",
    "@multifus/retro": "workspace:*",
    "@multifus/runes": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@lingui/babel-plugin-lingui-macro": "^6.8.0",
    "@lingui/cli": "^6.8.0",
    "@lingui/format-po": "^6.8.0",
    "@lingui/vite-plugin": "^6.8.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "commit-and-tag-version": "^13.2.1",
    "jsdom": "^30.1.1",
    "oxc-transform-react": "^0.151.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
