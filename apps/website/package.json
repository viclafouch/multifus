{
  "name": "@multifus/website",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm run draw:og && vite dev",
    "build": "pnpm run draw:og && vite build && node scripts/tidy-build.mjs",
    "draw:og": "node scripts/draw-og.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui compile --strict",
    "verify:html": "node scripts/verify-html.mjs",
    "check:web": "pnpm run i18n:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:html"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@lingui/core": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@multifus/ankama": "workspace:*",
    "@multifus/retro": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@lingui/vite-plugin": "^6.7.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
