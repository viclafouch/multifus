    "@multifus/runes": "workspace:*",
    "@tanstack/react-router": "^1.170.34",
    "@tanstack/react-start": "^1.168.51",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
