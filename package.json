{
  "name": "multifus",
  "private": true,
  "description": "Gestionnaire de fenêtres Dofus Retro en multicompte, macOS et Windows.",
  "homepage": "https://github.com/viclafouch/multifus#readme",
  "bugs": {
    "url": "https://github.com/viclafouch/multifus/issues"
  },
  "license": "MIT",
  "author": "Victor de la Fouchardiere <victor.delafouchardiere@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viclafouch/multifus.git"
  },
  "type": "module",
  "scripts": {
    "dev:app": "pnpm --filter @multifus/desktop dev:app",
    "dev:site": "pnpm --filter @multifus/website dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && turbo run check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@viclafouch/oxc-config": "^1.0.0-alpha.27",
    "husky": "^9.1.7",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
