{
  "name": "multifus",
  "version": "0.1.0",
  "private": true,
  "description": "Gestionnaire de fenêtres Dofus Retro en multicompte, macOS et Windows.",
  "homepage": "https://github.com/viclafouch/multifus#readme",
  "bugs": {
    "url": "https://github.com/viclafouch/multifus/issues"
  },
  "license": "MIT",
  "author": "Victor de la Fouchardiere <victor.delafouchardiere@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viclafouch/multifus.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev",
    "build": "tsc && vite build",
    "build:app": "tauri build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run format:rust:check && npm run lint:rust && npm run test:rust",
    "release": "commit-and-tag-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@viclafouch/oxc-config": "^1.0.0-alpha.27",
    "@vitejs/plugin-react": "^6.1.1",
    "commit-and-tag-version": "^13.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
