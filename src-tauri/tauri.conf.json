{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multifus",
  "version": "0.1.0",
  "identifier": "com.viclafouch.multifus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Multifus",
        "width": 880,
        "height": 660,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#1c1a17"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: http://localhost:1420",
        "font-src": "'self' data: http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxMEIzOEMzN0E5NjM5NDcKUldSSE9aWjZ3emdMa1dkcWZoajl5Y01NaUdaTWNQa213OXl1U3FreFV2aG1acWVKQ2Vhb2NCWmIK",
      "endpoints": [
        "https://github.com/viclafouch/multifus/releases/latest/download/latest.json"
      ]
    }
  }
}
