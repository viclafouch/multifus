{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "outputs": ["dist/**", ".output/**", ".vercel/**"]
    },
    "@multifus/website#build": {
      "inputs": ["$TURBO_DEFAULT$", "../desktop/CHANGELOG.*.md"],
      "outputs": ["dist/**", ".output/**", ".vercel/**"]
    },
    "typecheck": {},
    "test": {},
    "i18n:check": {},
    "check:web": {},
    "check:rust": {
      "dependsOn": ["build"]
    }
  }
}
